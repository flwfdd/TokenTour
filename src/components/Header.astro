---
// Global site header — shared by every route EXCEPT the playground
// (which runs full-bleed as its own app shell). The brand reads the same
// everywhere (big bold "TokenTour" linking home); a chunky cyan GitHub
// pill sits on the right.
---

<header class="site-bar">
  <a class="site-brand" href="/">TokenTour</a>
  <a class="site-gh" href="https://github.com/flwfdd/TokenTour" target="_blank" rel="noopener">
    <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
      <path
        d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"
      ></path>
    </svg>
    <span>GitHub</span>
  </a>
</header>

<style>
  .site-brand {
    position: relative;
    isolation: isolate;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--color-primary-500) !important;
  }
  /* Highlighter stroke behind the brand: an orange bar on a lower layer,
   * its top half overlapping the glyphs. */
  .site-brand::before {
    content: "";
    position: absolute;
    z-index: -1;
    left: -0.06em;
    right: -0.06em;
    bottom: 0.14em;
    height: 0.2em;
    background: color-mix(in oklch, var(--color-accent-500) 78%, transparent);
    border-radius: 2px;
  }
  /* Prominent GitHub entry: chunky cyan pill that fills on hover. Uses the
   * primary token straight (no neutral mix) so it reads as clean cyan
   * rather than a muddy grey-purple. */
  .site-gh {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.42rem 0.8rem;
    border: 1.5px solid var(--color-primary-500);
    border-radius: 999px;
    background: var(--color-paper);
    box-shadow: 0 2px 0 0 var(--color-primary-500);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-primary-500) !important;
    transition:
      transform 0.12s ease,
      box-shadow 0.12s ease,
      background 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .site-gh:hover {
    transform: translateY(-1px);
    border-color: var(--color-primary-500);
    background: var(--color-primary-500);
    color: #fff !important;
    box-shadow: 0 4px 0 0 var(--color-primary-700);
  }
  .site-gh:active {
    transform: translateY(2px);
    box-shadow: 0 0 0 0 var(--color-primary-700);
  }
</style>
