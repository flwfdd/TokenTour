---
import "~/styles/global.css";

interface Props {
  title?: string;
  lang?: string;
}
const { title = "TokenTour · From Agentic Context to KV Cache", lang = "en" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="TokenTour — interactive visualization from agentic messages to KV cache" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;600;700&display=swap"
    />
  </head>
  <body class="min-h-screen">
    <slot />
  </body>
</html>
