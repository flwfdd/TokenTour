---
import Layout from "~/layouts/Layout.astro";
import App from "~/islands/App.tsx";

// The shell is a static HTML page — the entire interactive surface is
// hydrated client-side by `<App>`. Prerendering keeps cold-start at zero
// (just an asset hit) and only the `/api/proxy` route is left for the
// Worker.
export const prerender = true;
---

<Layout>
  <App client:load />
</Layout>
