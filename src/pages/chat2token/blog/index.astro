---
// Thin route shell for the default chat2token long-form article (English).
//
// The prose lives with the topic (`topics/chat2token/blog/en/index.astro`);
// this page only adds Layout, site chrome, cover art, and the language switch.
import Layout from "~/layouts/Layout.astro";
import Header from "~/components/Header.astro";
import CoverHero from "~/components/CoverHero.astro";
import Toc from "~/components/Toc.astro";
import Article from "../../../../topics/chat2token/blog/en/index.astro";

export const prerender = true;
---

<Layout title="Chat to Token · From Prompt to KV Cache" lang="en">
  <Header langHref="/chat2token/blog/zh" langLabel="中文" langAria="Switch to Chinese" />

  <Toc title="Contents" />

  <main class="column blog">
    <CoverHero
      label="Chat to Token cover"
      titleLayout="stack"
      titleLines={[
        { text: "Chat", tone: "primary", size: "hero" },
        { text: "to", tone: "accent", size: "connector" },
        { text: "Token", tone: "primary", size: "hero" },
      ]}
    />
    <Article />
  </main>
</Layout>

<style>
  .blog {
    padding-top: 0.5rem;
  }
  .blog :global(.cover) {
    margin-bottom: 2rem;
  }
</style>
