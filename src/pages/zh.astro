---
// Chinese site home. The default `/` route is English; this route keeps the
// original Chinese copy available from the language switch.
import Layout from "~/layouts/Layout.astro";
import Header from "~/components/Header.astro";
import CoverHero from "~/components/CoverHero.astro";
import TopicCard from "~/components/TopicCard.astro";

export const prerender = true;

const topics = [
  {
    slug: "chat2token",
    title: "Chat to Token",
    desc: "从提示词到 KV Cache：和 AI 的对话如何变成 Messages、Chat Template、Tokens 和 KV Cache",
    accent: "var(--color-primary-500)",
  },
];
---

<Layout title="TokenTour · 交互式 LLM 可视化" lang="zh-CN">
  <Header langHref="/" langLabel="English" langAria="Switch to English" />

  <main class="column home">
    <CoverHero
      label="TokenTour 封面"
      titleLines={[
        { text: "Token", tone: "primary", size: "hero" },
        { text: "之旅", tone: "accent", size: "lead" },
      ]}
    />

    <p class="home__lede">
      TokenTour 是一系列视频、文章与实验。
      <br />
      带你以交互式可视化的方式，了解大模型 / Agent 的方方面面。
    </p>

    <div class="home__grid">
      {
        topics.map((t) => (
          <TopicCard
            href={`/${t.slug}/zh`}
            eyebrow={t.slug}
            title={t.title}
            desc={t.desc}
            accent={t.accent}
          />
        ))
      }
    </div>
  </main>
</Layout>

<style>
  .home {
    padding-top: 0.5rem;
  }
  .home__lede {
    margin: 2.25rem 0 2.5rem;
    max-width: 36rem;
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--color-ink-soft);
  }
  .home__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.1rem;
  }
</style>
