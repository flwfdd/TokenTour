---
// Thin route shell for the chat2token long-form article.
//
// Per the topic boundary convention, the prose lives with the topic
// (`topics/chat2token/blog/zh/index.astro`) and `src/pages/` only adds a
// Layout wrapper + site chrome. Static-prerendered: no Worker needed.
import Layout from "~/layouts/Layout.astro";
import Toc from "~/components/Toc.astro";
import Article from "../../../topics/chat2token/blog/zh/index.astro";

export const prerender = true;
---

<Layout title="Chat2Token · 从一句话到 KV Cache">
  <header class="site-bar">
    <a href="/">⟵ TokenTour</a>
    <span class="site-tag">chat2token · 中文</span>
  </header>

  <Toc />

  <main class="column">
    <Article />
  </main>

  <footer class="site-bar" style="margin-top: 2rem;">
    <span>chat2token</span>
    <span class="site-tag">TokenTour</span>
  </footer>
</Layout>
