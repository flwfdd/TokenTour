node_modules
.pnpm-store
.pnpm-debug.log*

# ─── Build output ────────────────────────────────────────────────────────
dist
.astro
.output
.vercel
.netlify
.cache
# ─── Cloudflare Wrangler ─────────────────────────────────────────────────
.wrangler
.dev.vars

