---
// Top-of-article playground entry — accent callout + CTA. Deliberately has
// no `tour` prop: general entrance only; section Try-it uses PlaygroundTry.
import Callout from "~/components/Callout.astro";
import PlaygroundTry from "./PlaygroundTry.astro";

interface Props {
  /** Where the playground lives. Defaults to the chat2token playground route. */
  href?: string;
  title?: string;
  label?: string;
}
const {
  href = "/chat2token/playground",
  title = "交互式 Playground",
  label = "打开 Playground",
} = Astro.props;
---

<Callout type="accent" title={title}>
  <p><slot /></p>
  <PlaygroundTry href={href} label={label} />
</Callout>
