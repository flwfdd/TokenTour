---
// Section "Try it" CTA → playground. Optional `tour` appends `?tour=<id>`
// (search only; share snapshots stay on `#s=…`). Canonical ids live in
// `topics/chat2token/app/tour/tourIds.ts`. ZH pages should pass
// href="/chat2token/playground/zh". Opens in a new tab via PlaygroundBtn.
import PlaygroundBtn from "./PlaygroundBtn.astro";

interface Props {
  href?: string;
  label?: string;
  /** When set, appends ?tour=<id> for playground driver.js guidance. */
  tour?: "messages" | "chat-template" | "tokens" | "kv-cache";
}
const {
  href = "/chat2token/playground",
  label,
  tour,
} = Astro.props;

const url = new URL(href, "https://tokentour.local");
if (tour) url.searchParams.set("tour", tour);
const finalHref = url.pathname + url.search;
---

<p class="pg-try">
  <PlaygroundBtn href={finalHref} label={label} />
</p>

<style>
  .pg-try {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.6rem;
    margin-bottom: 0;
  }
</style>
