---
// Causal-attention × KV-cache comparison. One causal (lower-triangular) grid,
// shown twice: WITHOUT cache every decode step recomputes the whole triangle
// (O(n²) total); WITH cache each step only computes the new token's row — the
// diagonal — and reads the rest from cache (O(n) total). Stepping the generation
// makes the two cumulative-compute counters diverge, which is the whole point.
import { RotateCcw, ArrowRight, Play, Pause } from "@lucide/astro";
import "./attention-kv-lab.css";

interface Props {
  title?: string;
  /** Short sequence — one chip per token. Keep it small so the grid is readable. */
  tokens?: string[];
}

const {
  title = "因果注意力 × KV Cache",
  // Real o200k tokenization of「语言的边界就是我世界的边界」.
  tokens = ["语言", "的", "边", "界", "就是", "我", "世界", "的", "边", "界"],
} = Astro.props;
const n = tokens.length;
const esc = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

const gridHtml =
  `<span class="akv__corner" aria-hidden="true"></span>` +
  tokens.map((t) => `<span class="akv__h akv__h--col">${esc(t)}</span>`).join("") +
  tokens
    .map(
      (t, i) =>
        `<span class="akv__h akv__h--row" data-row="${i}">${esc(t)}</span>` +
        tokens.map((_, j) => `<span class="akv__cell" data-i="${i}" data-j="${j}"></span>`).join(""),
    )
    .join("");
---

<div class="akv" data-akv data-akv-n={n}>
  <div class="akv__head">
    <span class="akv__title">{title}</span>
    <div class="akv__ctrl">
      <button class="btn btn-warning akv__btn" type="button" data-akv-reset aria-label="重置">
        <RotateCcw size={15} strokeWidth={2.5} />
      </button>
      <button class="btn btn-primary akv__btn" type="button" data-akv-step aria-label="生成下一个 Token">
        <ArrowRight size={15} strokeWidth={2.5} />
      </button>
      <button class="btn btn-success akv__btn" type="button" data-akv-auto aria-pressed="false">
        <Play class="akv__ic-play" size={15} strokeWidth={2.5} />
        <Pause class="akv__ic-pause" size={15} strokeWidth={2.5} />
        <span>自动</span>
      </button>
    </div>
  </div>

  <p class="akv__seq" data-akv-seq>
    {tokens.map((t, i) => <span class="akv__seqtok" data-i={i}>{t}</span>)}
  </p>

  <div class="akv__panels">
    <div class="akv__panel">
      <div class="akv__panel-head">
        <span class="akv__panel-title">无 KV Cache</span>
        <span class="akv__badge akv__badge--bad">累计重算 <b data-akv-bad-cum>0</b> 次</span>
      </div>
      <div class="akv__grid" data-akv-grid="nocache" style={`--n:${n}`} set:html={gridHtml} />
      <div class="akv__meter">三角形 · ~O(n²)<span class="akv__meter-step">本步 <b data-akv-bad-step>1</b></span></div>
    </div>

    <div class="akv__panel">
      <div class="akv__panel-head">
        <span class="akv__panel-title">有 KV Cache</span>
        <span class="akv__badge akv__badge--good">累计新算 <b data-akv-good-cum>0</b> 次</span>
      </div>
      <div class="akv__grid" data-akv-grid="cache" style={`--n:${n}`} set:html={gridHtml} />
      <div class="akv__meter">对角线 · ~O(n)<span class="akv__meter-step">本步 <b data-akv-good-step>1</b></span></div>
    </div>
  </div>

  <p class="akv__note" data-akv-note></p>

  <div class="akv__legend">
    <span class="akv__key"><i class="akv__sw akv__sw--calc"></i>本步计算（K/V）</span>
    <span class="akv__key"><i class="akv__sw akv__sw--cached"></i>从缓存读取（复用）</span>
    <span class="akv__key"><i class="akv__sw akv__sw--future"></i>还没生成</span>
  </div>
</div>

<script>
  function initAkv(root: HTMLElement) {
    const n = Math.max(1, Number(root.dataset.akvN) || 6);
    const gridNo = root.querySelector<HTMLElement>('[data-akv-grid="nocache"]')!;
    const gridCa = root.querySelector<HTMLElement>('[data-akv-grid="cache"]')!;
    const seqToks = Array.from(root.querySelectorAll<HTMLElement>(".akv__seqtok"));
    const badStep = root.querySelector<HTMLElement>("[data-akv-bad-step]")!;
    const goodStep = root.querySelector<HTMLElement>("[data-akv-good-step]")!;
    const badCum = root.querySelector<HTMLElement>("[data-akv-bad-cum]")!;
    const goodCum = root.querySelector<HTMLElement>("[data-akv-good-cum]")!;
    const noteEl = root.querySelector<HTMLElement>("[data-akv-note]")!;
    const resetBtn = root.querySelector<HTMLButtonElement>("[data-akv-reset]")!;
    const stepBtn = root.querySelector<HTMLButtonElement>("[data-akv-step]")!;
    const autoBtn = root.querySelector<HTMLButtonElement>("[data-akv-auto]")!;

    const cellsNo = Array.from(gridNo.querySelectorAll<HTMLElement>(".akv__cell"));
    const cellsCa = Array.from(gridCa.querySelectorAll<HTMLElement>(".akv__cell"));

    let t = 0; // index of the most-recently generated token (0..n-1)
    let timer: ReturnType<typeof setInterval> | null = null;

    const tri = (k: number) => ((k + 1) * (k + 2)) / 2; // cells in rows 0..k

    const classify = (cell: HTMLElement, kind: "nocache" | "cache") => {
      const i = Number(cell.dataset.i);
      const j = Number(cell.dataset.j);
      cell.className = "akv__cell";
      if (j > i) {
        cell.classList.add("is-mask"); // causal: token j is after query i
        return;
      }
      if (i > t) {
        cell.classList.add("is-future");
        return;
      }
      if (kind === "nocache") {
        cell.classList.add("is-calc"); // every step recomputes the whole triangle
      } else {
        cell.classList.add(j === i ? "is-calc" : "is-cached");
      }
    };

    const render = () => {
      cellsNo.forEach((c) => classify(c, "nocache"));
      cellsCa.forEach((c) => classify(c, "cache"));
      seqToks.forEach((s, i) => {
        s.classList.toggle("is-now", i === t);
        s.classList.toggle("is-future", i > t);
      });

      badStep.textContent = String(t + 1);
      goodStep.textContent = "1";
      badCum.textContent = String(tri(t));
      goodCum.textContent = String(t + 1);

      if (t === 0) {
        noteEl.innerHTML =
          `生成第 1 个 Token：两边都只算它自己。点 <b>下一步</b> 继续生成，看两种做法怎么分道扬镳。`;
      } else if (t < n - 1) {
        noteEl.innerHTML =
          `生成第 <b>${t + 1}</b> 个 Token：<b>无缓存</b>把前面 <b>${t + 1}</b> 个 Token 的 K/V 全部重算（整行橙色）；<b>有缓存</b>只算新 Token 这一个（对角橙色），其余 <b>${t}</b> 个直接读缓存（绿色）。`;
      } else {
        noteEl.innerHTML =
          `生成完 <b>${n}</b> 个 Token：无缓存累计算了 <b>${tri(t)}</b> 次（整个三角形，~O(n²)）；有缓存只算了 <b>${t + 1}</b> 次（对角线，~O(n)）。这就是 KV Cache 省下的。`;
      }

      stepBtn.disabled = t >= n - 1;
    };

    const stop = () => {
      if (timer) clearInterval(timer);
      timer = null;
      autoBtn.setAttribute("aria-pressed", "false");
    };
    const step = () => {
      if (t < n - 1) t += 1;
      render();
      if (t >= n - 1) stop();
    };

    resetBtn.addEventListener("click", () => {
      stop();
      t = 0;
      render();
    });
    stepBtn.addEventListener("click", step);
    autoBtn.addEventListener("click", () => {
      if (timer) {
        stop();
        return;
      }
      if (t >= n - 1) {
        t = 0;
        render();
      }
      autoBtn.setAttribute("aria-pressed", "true");
      timer = setInterval(step, 900);
    });

    render();
  }

  document.querySelectorAll<HTMLElement>("[data-akv]").forEach((el) => initAkv(el));
</script>
