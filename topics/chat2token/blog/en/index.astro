    "role": "system", // Agree with the model on a tool-call format.
    "content": "When you need to add numbers, output \`add(a, b)\`, where a and b are numbers."
  },
  {
    "role": "user", // User asks a question.
    "content": "1 + 1 = ?"
  },
  {
    "role": "assistant", // The model calls a tool in plain text.
    "content": "add(1, 1)"
